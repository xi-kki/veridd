# Veridd Frontend — Environment Configuration
#
# Copy this file to .env and override values for your deployment.
# The .env file is gitignored; never commit secrets.

# Contract address for the VeriddReputation contract.
# Defaults to the testnet address if left unset.
# VITE_CONTRACT_ADDRESS=0xYourContractAddressHere

# 0G Chain RPC endpoint (optional — defaults to Galileo testnet)
# VITE_RPC_URL=https://evmrpc-testnet.0g.ai
